%% 4.1 后台周期采集 → setLatest → push → 持久化
sequenceDiagram
  participant BJ as startBackgroundJobs
  participant MC as metricCollector
  participant CS as credentialService
  participant SS as sshService.collectMetrics
  participant HM as hostMetricsCache
  participant MS as metricSeriesStore
  participant PS as persist.ts

  BJ->>MC: start() (60s interval)
  loop 每 60s（并发≤5）
    MC->>MC: collectAsset(assetId)
    MC->>CS: decrypt(credentialId)
    CS-->>MC: {username,password,privateKey}
    MC->>SS: collectMetrics({host,port,...})
    SS->>HM: setLatest(sample)
    SS->>MS: push(sample)
    MS->>MS: 追加 + 裁剪至 MAX_POINTS(1440)
    MS->>PS: scheduleFileWrite('metrics.json', snapshot)
    PS-->>PS: 400ms 防抖原子写
  end

%% 4.2 Hosts Drawer → GET history → recharts 渲染
sequenceDiagram
  participant U as 用户
  participant H as Hosts.tsx
  participant D as HostTrendDrawer
  participant B as bus.ts(api.metrics.history)
  participant R as GET /api/metrics/history
  participant MS as metricSeriesStore
  participant C as MetricLineChart(recharts)

  U->>H: 点击行「详情」
  H->>D: open(assetId)
  D->>B: history({assetId, from, to})  // 默认 24h
  B->>R: GET /api/metrics/history?assetId&from&to
  R->>MS: query(assetId, from, to, 200)
  MS-->>R: HostMetricSample[] (降采样后)
  R-->>B: {code:0, data:[...]}
  B-->>D: samples
  D->>C: 每指标一组 series (CPU/内存/磁盘/负载/网络P1)
  C-->>D: 折线 + 十字光标 + tooltip + 阈值描点
  U->>D: 切换 1h/6h/24h
  D->>B: history({assetId, from, to})  // 重算 from/to

%% 4.3 告警生成 → notify → email(SMTP)
sequenceDiagram
  participant AR as alertRuleService.evaluateAll
  participant NS as notificationService.notify
  participant M as memoryStore(启用渠道)
  participant CR as crypto.decrypt
  participant NM as nodemailer
  participant LOG as 日志

  AR->>NS: notify(alert)
  NS->>M: getNotificationChannels().filter(enabled && type!='inapp')
  loop 每个启用渠道
    alt type === 'email'
      NS->>CR: decrypt(smtpPasswordEnc)
      CR-->>NS: password(明文, 仅内存)
      NS->>NM: sendMail({host,port,secure,user,pass,from,to,text:buildText(alert)})
      NM-->>NS: ok/fail
    else webhook/feishu/dingtalk
      NS->>CR: decrypt(secretEnc)
      NS->>NS: sendWebhook(...)
    end
  end
  NS-->>AR: sent 计数（失败仅记 LOG，不阻断告警落库）
