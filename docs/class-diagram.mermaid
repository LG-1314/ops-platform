classDiagram
  class HostMetricSample {
    +string assetId
    +string collectedAt
    +string hostname
    +number cpuIdle
    +number memUsedMb
    +number memTotalMb
    +DiskUsage[] disk
    +NetSample network
    +Status status
  }
  class NetSample {
    +number rxBytes
    +number txBytes
    +number rxRate
    +number txRate
  }
  class NotificationChannel {
    +string id
    +string name
    +NotificationChannelType type
    +boolean enabled
    +string url
    +string secretEnc
    +string smtpHost
    +number smtpPort
    +boolean smtpSecure
    +string smtpUser
    +string smtpPasswordEnc
    +string smtpFrom
    +string smtpTo
  }
  class MetricSeriesStore {
    -Map~string,HostMetricSample[]~ series
    -number MAX_POINTS
    +push(sample) void
    +query(assetId, from, to, maxPoints) HostMetricSample[]
    +getLatest(assetId) HostMetricSample
    +load() void
    +save() void
    -downsample(samples, max) HostMetricSample[]
  }
  class MetricCollector {
    -number INTERVAL_MS
    -number CONCURRENCY
    +start() Timer
    +stop() void
    +collectAsset(assetId) Promise~void~
  }
  class NotificationService {
    +list() NotificationChannel[]
    +create(input) NotificationChannel
    +update(id, input) NotificationChannel
    +remove(id) boolean
    +notify(alert) Promise~number~
    -sendEmail(channel, text) Promise~boolean~
    -sendWebhook(channel, text) Promise~boolean~
  }
  class Crypto {
    +encrypt(plain) string
    +decrypt(b64) string
  }
  class Persist {
    +scheduleFileWrite(file, data) void
    +readFileJSON(file) unknown
    +flushFile(file) void
  }
  HostMetricSample *-- NetSample
  MetricCollector ..> HostMetricSample : produces
  MetricCollector ..> MetricSeriesStore : push
  MetricSeriesStore ..> Persist : save / load
  NotificationService ..> Crypto : encrypt / decrypt
  MetricsRouter ..> MetricSeriesStore : query
